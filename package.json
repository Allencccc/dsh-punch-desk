{
  "name": "dsh-punch-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "Draft prompts before a session, capture findings as you work, and keep a per-workspace ledger of sessions, drafts, and review decisions.",
  "license": "MIT",
  "author": "Allencccc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Allencccc/dsh-punch-desk.git"
  },
  "homepage": "https://github.com/Allencccc/dsh-punch-desk#readme",
  "bugs": {
    "url": "https://github.com/Allencccc/dsh-punch-desk/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "punch-desk",
    "prompt",
    "session",
    "plugin"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "logo.svg",
    "README.md",
    "README.en.md",
    "docs/mockup/previews/",
    "docs/plugin-detail/",
    "docs/brand/",
    "src/store/",
    "src/domain/"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1"
  }
}
